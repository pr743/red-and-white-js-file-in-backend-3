<!DOCTYPE html>
<html>
<head>
  <title>Event Management System</title>
  <link rel="stylesheet" href="/style.css">
   <link rel="icon" href="https://cdn-icons-png.flaticon.com/128/19025/19025414.png">
</head>
<body>

  <div class="container">

    <h1>Event Management System</h1>

    <div class="nav">
      <a href="/" class="btn">Home</a>
      <a href="/add" class="btn">Register Event</a>
    </div>

    
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="alert success" id="flashMessage"><%= success %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="alert error" id="flashMessage"><%= error %></div>
    <% } %>

    
    <%- body %>

  </div>

  <script>
    
    const flash = document.getElementById("flashMessage");
    if(flash){
      setTimeout(()=>{ flash.style.display = "none"; },3000);
    }

    
    function confirmDelete() {
      return confirm("Are you sure you want to delete this event?");
    }
  </script>
</body>
</html>