<!DOCTYPE html>
<html>
<head>
  <title>Event List</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">

    <h2>All Events</h2>

    
    <form action="/" method="GET" class="search-form">
      <input 
        type="text"
        name="search"
        placeholder="Search by event title..."
        value="<%= search %>"
      > 
      <button type="submit">Search</button>
    </form>

    
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="success"><%= success %></div>
    <% } %>

    
    <% if (!events || events.length === 0) { %>
      <p>No Events Found</p>
    <% } else { %>

      <ul class="event-list">
        <% events.forEach(function(event){ %>
          <li>
            <div>
              <strong><%= event.eventTitle %></strong><br>
              <small><%= event.name %> | <%= event.email %></small>
            </div>

            <div>
              <a href="/edit/<%= event._id %>" class="edit">Edit</a>
              <a href="/delete/<%= event._id %>" 
                 class="delete" 
                 onclick="return confirm('Are you sure you want to delete this event?')">
                 Delete
              </a>
            </div>
          </li>
        <% }) %>
      </ul>

    <% } %>

    
    <% if (totalPages && totalPages > 1) { %>
      <div class="pagination">

        <% if (currentPage > 1) { %>
          <a href="/?page=<%= currentPage - 1 %>&search=<%= search %>">Prev</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/?page=<%= i %>&search=<%= search %>" 
             class="<%= currentPage === i ? 'active' : '' %>">
             <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
        <% } %>

      </div>
    <% } %>

  </div>
</body>
</html>