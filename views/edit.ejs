<!DOCTYPE html>
<html>
<head>
  <title>Edit Event</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="https://cdn-icons-png.flaticon.com/128/16000/16000160.png">
</head>
<body>

  <div class="container">
    <h1>Edit Event</h1>

    <form action="/edit/<%= event._id %>" method="POST">

      <input 
        type="text" 
        name="name" 
        value="<%= event.name %>" 
        required
      >

      <input 
        type="email" 
        name="email" 
        value="<%= event.email %>" 
        required
      >

      <input 
        type="text" 
        name="eventTitle" 
        value="<%= event.eventTitle %>" 
        required
      >

      <button type="submit">Update</button>
    </form>

    <br>
    <a href="/" class="btn">Back</a>

  </div>

</body>
</html>